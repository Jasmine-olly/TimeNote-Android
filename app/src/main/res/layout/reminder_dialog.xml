<?xml version="1.0" encoding="utf-8"?>
<!-- F1.3 阈值提醒弹窗：三选一操作（纸感卡片 + 纸感按钮） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_bg">

    <TextView
        android:id="@+id/reminder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="时间到 ⏰"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#4A4438" />

    <TextView
        android:id="@+id/reminder_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#6B6559"
        android:textSize="15sp"
        android:text="已连续使用娱乐应用 30:00" />

    <Button
        android:id="@+id/btn_snooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_paper_solid"
        android:textColor="#FFFFFF"
        android:text="再玩5分钟" />

    <Button
        android:id="@+id/btn_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_paper_outline"
        android:textColor="#4A4438"
        android:text="退出应用" />

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:textColor="#6B6559"
        style="?android:attr/borderlessButtonStyle"
        android:text="关闭提醒" />
</LinearLayout>
